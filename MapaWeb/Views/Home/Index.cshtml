@{
    ViewData["Title"] = "Mapa IGN";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />

<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />

<style>
    /* Estilo del Mapa */
    #mapaIGN {
        height: 600px; 
        width: 100%;
    }

    /* Estilo para que el buscador se vea bien */
    .leaflet-control-geocoder {
        z-index: 1000; /* Asegura que se vea arriba de todo */
    }

    /* Estilos para los botones del CRUD */
    .btn-borrar, .btn-editar, .btn-guardar {
        color: white;
        border: none;
        padding: 4px 8px;
        cursor: pointer;
        font-size: 12px;
        margin-top: 5px;
        border-radius: 3px;
    }

    .btn-borrar {
        background-color: #f44336; /* Rojo */
    }

        .btn-borrar:hover {
            background-color: #d32f2f;
        }

    .btn-editar {
        background-color: #007bff; /* Azul */
    }

        .btn-editar:hover {
            background-color: #0056b3;
        }

    .btn-guardar {
        background-color: #4CAF50; /* Verde */
    }

        .btn-guardar:hover {
            background-color: #45a049;
        }

    .leaflet-routing-container {
        display: none;
    }
</style>

<h2>Mapa con API del IGN</h2>
<p>Haz clic en el mapa para agregar un nuevo marcador o usa el buscador.</p>

<div id="mapaIGN"></div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <script>
        var map;
        var marcadoresEnMapa = {}; // Objeto para guardar los 'pins'
        var searchMarker = null;

        document.addEventListener("DOMContentLoaded", function () {

            // --- Configuración Inicial ---
            const latitud = -38.416097;
            const longitud = -63.616672;
            const zoom = 5;

            // --- Capas Base ---
            var argenmap = L.tileLayer('https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{-y}.png', {
                attribution: '© <a href="https://www.ign.gob.ar/">IGN</a>',
                minZoom: 1,
                maxZoom: 20
            });
            var mapaSatelital = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri'
            });
            var baseMaps = {
                "Mapa Estándar (IGN)": argenmap,
                "Satelital (Esri)": mapaSatelital
            };

            // --- Inicialización del Mapa ---
            map = L.map('mapaIGN', {
                center: [latitud, longitud],
                zoom: zoom,
                layers: [argenmap]
            });

            // --- Control de Capas ---
            L.control.layers(baseMaps).addTo(map);

            // --- Control de Búsqueda (Buscador Nominatim) ---
            var geocoder = L.Control.geocoder({
                defaultMarkGeocode: false,
                position: 'topright',
                placeholder: 'Buscar calles o lugares...',
                geocoder: L.Control.Geocoder.nominatim({
                    geocodingQueryParams: {
                        countrycodes: 'ar' // Limitar búsqueda a Argentina
                    }
                })
            })
            .on('markgeocode', function(e) {
                var latlng = e.geocode.center;
                if (searchMarker) {
                    map.removeLayer(searchMarker);
                }
                searchMarker = L.marker(latlng).addTo(map);
                searchMarker.bindPopup(e.geocode.name).openPopup();
                map.flyTo(latlng, 16);
            })
            .addTo(map);

            var router = L.Routing.osrmv1({
                serviceUrl: 'https://router.project-osrm.org/route/v1',
                language: 'es',
                alternatives: false // <-- Pide rutas alternativas
            });

                    // Ruta 1: CABA -> Rosario -> Córdoba
        var ruta1 = L.Routing.control({
            waypoints: [
                L.latLng(-34.6037, -58.3816), // CABA
                L.latLng(-31.4201, -64.1888)   // Córdoba
            ],
            router: router,
            showAlternatives: false,
            fitSelectedRoutes: false, 
            show: false,
            addWaypoints: false,
            draggableWaypoints: false,
            lineOptions: {
                styles: [
                    {color: '#007bff', opacity: 0.8, weight: 6} // Azul
                ]
            }
        }).addTo(map);

        // Ruta 2: CABA -> Rojas -> Córdoba
        var ruta2 = L.Routing.control({
            waypoints: [
                L.latLng(-34.6037, -58.3816), // CABA
                L.latLng(-34.1980, -60.7339), //lujan
                L.latLng(-33.1301, -64.3499),// Rojas, punto intermedio
                L.latLng(-31.4201, -64.1888)   // Córdoba
            ],
            router: router,
            showAlternatives: false,
            fitSelectedRoutes: false,
            show: false,
            addWaypoints: false,
            draggableWaypoints: false,
            createMarker: function() { return null; },
            lineOptions: {
                styles: [
                    {color: '#dc3545', opacity: 0.8, weight: 6} // Rojo 
                ]
            }
        }).addTo(map);
        // Ruta 3: CABA -> gualeguay -> santa fe -> Córdoba
        var ruta3 = L.Routing.control({
            waypoints: [
                L.latLng(-34.6037, -58.3816), // CABA
                L.latLng(-33.1473, -59.3041),//gualeguay
                L.latLng(-31.6157, -60.7048), //Sta Fe capital
                L.latLng(-31.4201, -64.1888)   // Córdoba
            ],
            router: router,
            showAlternatives: false,
            fitSelectedRoutes: false,
            show: false,
            addWaypoints: false,
            draggableWaypoints: false,
            createMarker: function() { return null; },
            lineOptions: {
                styles: [
                    {color: '#dc3545', opacity: 0.8, weight: 6} // Rojo

                ]
            }
        }).addTo(map);
                // Variable para controlar visibilidad
        var rutasVisibles = true;

        // Crear botón para mostrar/ocultar rutas
        var botonRutas = L.control({position: 'topright'});

        botonRutas.onAdd = function(map) {
            var div = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
            div.innerHTML = '<a href="#" title="Mostrar/Ocultar Rutas" style="width: 34px; height: 34px; line-height: 34px; text-align: center; font-size: 18px; text-decoration: none; display: block;">🛣️</a>';

            div.onclick = function(e) {
                L.DomEvent.stop(e);
                e.preventDefault();
                if (rutasVisibles) {
                    map.removeControl(ruta1);
                    map.removeControl(ruta2);
                    map.removeControl(ruta3);
                    rutasVisibles = false;
                } else {
                    ruta1.addTo(map);
                    ruta2.addTo(map);
                    ruta3.addTo(map);
                    rutasVisibles = true;
                }
            };

            return div;
        };

               // ... después de ruta3 y antes del botón de rutas, agregá esto:

        // ============================================
        // TRIÁNGULO EQUILÁTERO INVERTIDO
        // ============================================

        // Coordenadas exactas del triángulo invertido
        // Sur de Córdoba, Sur de Santa Fe, Noroeste de Buenos Aires

        // Vértice superior (norte) - Sur de Córdoba
        var verticeNorte = [-33.987074573755905, -63.622237592445565];

        // Vértice inferior izquierdo (suroeste) - Sur de Santa Fe
        var verticeSurOeste = [-33.987074573755905, -61.4693868116242];

        // Vértice inferior derecho (sureste) - Noroeste de Buenos Aires
        var verticeSurEste = [-35.255355059007194, -62.545812202034885];

        // Crear el polígono
        var triangulo = L.polygon([
            verticeNorte,
            verticeSurEste,
            verticeSurOeste
        ], {
            color: '#003366',      // Azul oscuro para el borde
            fillColor: '#003366',  // Azul oscuro para el relleno
            fillOpacity: 0.4,
            weight: 3
        }).addTo(map);

        // Agregar popup con información
        triangulo.bindPopup(`
            <b>Triángulo Equilátero Invertido</b><br>
            Zona: Sur Córdoba - Sur Santa Fe - NO Buenos Aires<br>
            <small>Vértice Norte: ${verticeNorte}</small><br>
            <small>Vértice SO: ${verticeSurOeste}</small><br>
            <small>Vértice SE: ${verticeSurEste}</small>
        `);

        // ============================================
        // FIN DEL TRIÁNGULO
        // ============================================

        // Variable para controlar visibilidad

                var trianguloVisible = true;

        // Crear botón para mostrar/ocultar triángulo
        var botonTriangulo = L.control({position: 'topright'});

        botonTriangulo.onAdd = function(map) {
            var div = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
            div.innerHTML = '<a href="#" title="Mostrar/Ocultar Triángulo" style="width: 34px; height: 34px; line-height: 34px; text-align: center; font-size: 18px; text-decoration: none; display: block;">▲</a>';

            div.onclick = function(e) {
                L.DomEvent.stop(e);
                e.preventDefault();
                if (trianguloVisible) {
                    map.removeLayer(triangulo);
                    trianguloVisible = false;
                } else {
                    triangulo.addTo(map);
                    trianguloVisible = true;
                }
            };

            return div;
        };

        botonRutas.addTo(map);
        botonTriangulo.addTo(map);

        var rutasVisibles = true;

        // Ajustar el zoom para ver ambas rutas
        // map.fitBounds([
        //     [-34.6037, -58.3816],
        //     [-31.4201, -64.1888]
        // ]);

            // --- Carga del CRUD ---
            cargarMarcadores();

            // Evento de clic en el mapa (para crear)
            map.on('click', function(e) {
                abrirPopupParaNuevoMarcador(e.latlng);
            });
        });

        // --- FUNCIONES PARA EL CRUD ---

        // ===================================================================
        // AQUÍ ESTÁ EL CAMBIO
        // ===================================================================
        function agregarMarcadorAlMapa(marcador) {
            console.log("Marcador recibido:", marcador); // ← AGREGÁ ESTA LÍNEA
            // 1. Leemos las coordenadas del objeto 'ubicacion'
            //    GeoJSON es [Longitud, Latitud]
            

            // 2. Leaflet espera [Latitud, Longitud], así que damos vuelta el array
            const latLng = [marcador.latitud, marcador.longitud];

            var pin = L.marker(latLng).addTo(map);

            // 3. Guardamos los datos "aplanados" en el pin.
            //    Esto es CLAVE para que la función 'guardarEdicion'
            //    siga funcionando sin cambios.
            pin.markerData = {
                id: marcador.id,
                nombre: marcador.nombre,
                latitud: marcador.latitud,
                longitud: marcador.longitud
            };

            var popupContent = `
                <div id="popup-ver-${marcador.id}">
                    <b>${marcador.nombre}</b>
                    <br>
                    <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${marcador.id})">Editar</button>
                    <button class="btn-borrar" onclick="borrarMarcador(event, ${marcador.id})">Borrar</button>
                </div>
        `;
            pin.bindPopup(popupContent);
            marcadoresEnMapa[marcador.id] = pin;
        }
        // ===================================================================
        // FIN DEL CAMBIO
        // ===================================================================


        // LEER (Read): Carga todos los marcadores desde la API
        // (Esta función NO CAMBIA, porque solo pasa el 'marcador' a la función que SÍ cambiamos)
        async function cargarMarcadores() {
            try {
                const response = await fetch('/api/marcadores');
                if (!response.ok) throw new Error('Error al cargar marcadores');
                const marcadores = await response.json();
                marcadores.forEach(function(marcador) {
                    agregarMarcadorAlMapa(marcador);
                });
            } catch (error) {
                console.error("Error en cargarMarcadores:", error);
            }
        }

        // CREAR (Create): Muestra el popup para pedir el nombre
        // (Esta función NO CAMBIA)
        function abrirPopupParaNuevoMarcador(latlng) {
            var lat = latlng.lat.toFixed(6);
            var lng = latlng.lng.toFixed(6);

            var popupContent = `
                <div>
                    <b>Nuevo Marcador</b><br>
                    <small>Lat: ${lat}, Lng: ${lng}</small>
                    <hr style="margin: 4px 0;">
                    Nombre: <input type='text' id='inputNombreMarcador' />
                    <br>
                    <button onclick='guardarMarcador(event, ${latlng.lat}, ${latlng.lng})'>Guardar</button>
                </div>`;
            L.popup()
                .setLatLng(latlng)
                .setContent(popupContent)
                .openOn(map);
        }

        // CREAR (Create): Guarda el nuevo marcador en la BBDD
        // (Esta función NO CAMBIA. Ya envía el DTO {nombre, latitud, longitud}
        // y recibe el objeto 'marcadorGuardado' completo, que pasa
        // a nuestra nueva función 'agregarMarcadorAlMapa')
        async function guardarMarcador(event, lat, lng) {
            event.stopPropagation();
            const nombre = document.getElementById('inputNombreMarcador').value;
            if (!nombre) { alert('Por favor, ingresa un nombre.'); return; }
            const nuevoMarcador = { nombre: nombre, latitud: lat, longitud: lng };
            try {
                const response = await fetch('/api/marcadores', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(nuevoMarcador)
                });
                if (!response.ok) throw new Error('Error al guardar el marcador');
                const marcadorGuardado = await response.json();
                agregarMarcadorAlMapa(marcadorGuardado);
                map.closePopup();
            } catch (error) {
                console.error("Error en guardarMarcador:", error);
                alert('No se pudo guardar el marcador.');
            }
        }

        // BORRAR (Delete)
        // (Esta función NO CAMBIA)
        async function borrarMarcador(event, id) {
            event.stopPropagation();
            if (!confirm("¿Seguro que querés borrar este marcador?")) return;
            try {
                const response = await fetch(`/api/marcadores/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Error al borrar el marcador');
                var pin = marcadoresEnMapa[id];
                map.removeLayer(pin);
                delete marcadoresEnMapa[id];
                map.closePopup();
            } catch (error) {
                console.error("Error en borrarMarcador:", error);
                alert('No se pudo borrar el marcador.');
            }
        }

        // EDITAR (Update) - Paso 1: Mostrar formulario
        // (Esta función NO CAMBIA)
        function mostrarFormularioEdicion(event, id) {
            event.stopPropagation();
            var pin = marcadoresEnMapa[id];
            var data = pin.markerData;

            var formContent = `
                <div>
                    <b>Editando:</b>
                    <br>
                    Nombre: <input type='text' id='inputEditarNombre-${id}' value='${data.nombre}' />
                    <br>
                    <button class="btn-guardar" onclick="guardarEdicion(event, ${id})">Guardar</button>
                    <button onclick="cancelarEdicion(event, ${id})">Cancelar</button>
                </div>
            `;
            pin.setPopupContent(formContent);
        }

        // EDITAR (Update) - Paso 2: Cancelar
        // (Esta función NO CAMBIA)
        function cancelarEdicion(event, id) {
            event.stopPropagation();
            var pin = marcadoresEnMapa[id];
            var data = pin.markerData;
             var popupContent = `
                <div id="popup-ver-${data.id}">
                    <b>${data.nombre}</b>
                    <br>
                    <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${data.id})">Editar</button>
                    <button class="btn-borrar" onclick="borrarMarcador(event, ${data.id})">Borrar</button>
                </div>
            `;
            pin.setPopupContent(popupContent);
        }

        // EDITAR (Update) - Paso 3: Guardar cambios
        // (Esta función NO CAMBIA. Gracias a que 'pin.markerData'
        // ahora se guarda aplanado, sigue teniendo 'latitud' y 'longitud'
        // para enviar el DTO de actualización correctamente).
        async function guardarEdicion(event, id) {
            event.stopPropagation();

            var pin = marcadoresEnMapa[id];
            var dataOriginal = pin.markerData;
            const nuevoNombre = document.getElementById(`inputEditarNombre-${id}`).value;
            if (!nuevoNombre) { alert('El nombre no puede estar vacío.'); return; }
            const marcadorActualizado = {
                id: id,
                nombre: nuevoNombre,
                latitud: dataOriginal.latitud,
                longitud: dataOriginal.longitud
            };
            try {
                const response = await fetch(`/api/marcadores/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(marcadorActualizado)
                });
                if (!response.ok) throw new Error('Error al actualizar en la API');

                pin.markerData.nombre = nuevoNombre; // Actualizamos el dato local

                var popupContent = `
                    <div id="popup-ver-${id}">
                        <b>${nuevoNombre}</b>
                        <br>
                        <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${id})">Editar</button>
                        <button class="btn-borrar" onclick="borrarMarcador(event, ${id})">Borrar</button>
                    </div>
                `;
                pin.setPopupContent(popupContent);

            } catch (error) {
                console.error("Error en guardarEdicion:", error);
                alert('No se pudieron guardar los cambios.');
            }
        }

    </script>
}