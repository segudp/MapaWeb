@{
    ViewData["Title"] = "Mapa IGN";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />

<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
<style>
    /* Estilo del Mapa */
    #mapaIGN {
        height: 600px;
        width: 100%;
    }

    /* Estilo buscador */
    .leaflet-control-geocoder {
        z-index: 1000;
    }

    /* Estilos para los botones del CRUD */
    .btn-borrar, .btn-editar, .btn-guardar {
        color: white;
        border: none;
        padding: 4px 8px;
        cursor: pointer;
        font-size: 12px;
        margin-top: 5px;
        border-radius: 3px;
    }

    .btn-borrar {
        background-color: #f44336;
    }

        .btn-borrar:hover {
            background-color: #d32f2f;
        }

    .btn-editar {
        background-color: #007bff;
    }

        .btn-editar:hover {
            background-color: #0056b3;
        }

    .btn-guardar {
        background-color: #4CAF50;
    }

        .btn-guardar:hover {
            background-color: #45a049;
        }

    .leaflet-routing-container {
        display: none;
    }

    /* Estilos para el menú desplegable */
    .menu-desplegable {
        background: white;
        border-radius: 4px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.4);
        text-align: right; /* Alineación a la derecha */
    }

        .menu-desplegable .menu-toggle {
            width: 34px;
            height: 34px;
            line-height: 34px;
            text-align: center;
            font-size: 18px;
            text-decoration: none;
            display: inline-block; /* Cambio para alineación */
            cursor: pointer;
            background: white;
            border-bottom: 1px solid #ccc;
        }

            .menu-desplegable .menu-toggle:hover {
                background: #f4f4f4;
            }

        .menu-desplegable .menu-items {
            display: none;
            padding: 5px;
            text-align: left; /* Items alineados a la izquierda dentro del menú */
        }

        .menu-desplegable.abierto .menu-items {
            display: block;
        }

        .menu-desplegable .menu-item {
            width: 100%;
            padding: 8px 12px;
            margin: 2px 0;
            background: white;
            border: 1px solid #ccc;
            border-radius: 3px;
            cursor: pointer;
            text-align: left;
            font-size: 13px;
        }

            .menu-desplegable .menu-item:hover {
                background: #f4f4f4;
            }
</style>

<h2>Mapa con API del IGN</h2>
<p>Haz <strong>doble clic</strong> en el mapa para agregar un nuevo marcador</p>

<div id="mapaIGN"></div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
    <script>
        // ===================================================================
        // VARIABLES GLOBALES
        // ===================================================================
        var map;
        var marcadoresEnMapa = {}; // Objeto para guardar los marcadores por ID
        var poligonosEnMapa = []; // Array para guardar todos los polígonos cargados
        var searchMarker = null; // Marcador temporal de búsqueda

        document.addEventListener("DOMContentLoaded", function () {

            // ===================================================================
            // CONFIGURACIÓN INICIAL DEL MAPA
            // ===================================================================
            const latitud = -38.416097;
            const longitud = -63.616672;
            const zoom = 5;

            // ===================================================================
            // CAPAS BASE
            // ===================================================================
            var argenmap = L.tileLayer('https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{-y}.png', {
                attribution: '© <a href="https://www.ign.gob.ar/">IGN</a>',
                minZoom: 1,
                maxZoom: 20
            });

            var mapaSatelital = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri'
            });

            var baseMaps = {
                "Mapa Estándar (IGN)": argenmap,
                "Satelital (Esri)": mapaSatelital
            };

            // ===================================================================
            // INICIALIZACIÓN DEL MAPA
            // ===================================================================
            map = L.map('mapaIGN', {
                center: [latitud, longitud],
                zoom: zoom,
                layers: [argenmap],
                zoomControl: false // Desactivamos el control por defecto
            });

            // ===================================================================
            // CONTROLES DEL MAPA
            // ===================================================================

            // Control de Zoom (abajo a la derecha)
            L.control.zoom({
                position: 'bottomright'
            }).addTo(map);

            // Control de Capas (abajo a la izquierda)
            L.control.layers(baseMaps, null, {
                position: 'bottomleft'
            }).addTo(map);

            // Control de Búsqueda (arriba a la izquierda)
            var geocoder = L.Control.geocoder({
                defaultMarkGeocode: false,
                position: 'topleft',
                placeholder: 'Buscar calles o lugares...',
                geocoder: L.Control.Geocoder.nominatim({
                    geocodingQueryParams: {
                        countrycodes: 'ar' // Limitar búsqueda a Argentina
                    }
                })
            })
            .on('markgeocode', function(e) {
                var latlng = e.geocode.center;

                // Eliminar marcador de búsqueda anterior si existe
                if (searchMarker) {
                    map.removeLayer(searchMarker);
                }

                // Crear nuevo marcador de búsqueda
                searchMarker = L.marker(latlng).addTo(map);
                searchMarker.bindPopup(e.geocode.name).openPopup();
                map.flyTo(latlng, 16);

                // Eliminar marcador al cerrar el popup
                searchMarker.on('popupclose', function() {
                    map.removeLayer(searchMarker);
                    searchMarker = null;
                });
            })
            .addTo(map);

            // ===================================================================
            // CONFIGURACIÓN DE RUTAS
            // ===================================================================

            var router = L.Routing.osrmv1({
                serviceUrl: 'https://router.project-osrm.org/route/v1',
                language: 'es',
                alternatives: false
            });

            // Ruta 1: CABA -> Córdoba (Ruta directa)
            var ruta1 = L.Routing.control({
                waypoints: [
                    L.latLng(-34.6037, -58.3816), // CABA
                    L.latLng(-31.4201, -64.1888)   // Córdoba
                ],
                router: router,
                showAlternatives: false,
                fitSelectedRoutes: false,
                show: false,
                addWaypoints: false,
                draggableWaypoints: false,
                lineOptions: {
                    styles: [
                        {color: '#007bff', opacity: 0.8, weight: 6}
                    ]
                }
            }).addTo(map);

            // Ruta 2: CABA -> Luján -> Rojas -> Rio Negro -> Córdoba
            var ruta2 = L.Routing.control({
                waypoints: [
                    L.latLng(-34.6037, -58.3816), // CABA
                    L.latLng(-34.5560, -59.1001), // Lujan
                    L.latLng(-34.1980, -60.7339), // Rojas
                    L.latLng(-33.1301, -64.3499), // Rio Negro
                    L.latLng(-31.4201, -64.1888)  // Córdoba
                ],
                router: router,
                showAlternatives: false,
                fitSelectedRoutes: false,
                show: false,
                addWaypoints: false,
                draggableWaypoints: false,
                createMarker: function() { return null; },
                lineOptions: {
                    styles: [
                        {color: '#dc3545', opacity: 0.8, weight: 6}
                    ]
                }
            }).addTo(map);

            // Ruta 3: CABA -> Gualeguay -> Santa Fe -> Córdoba
            var ruta3 = L.Routing.control({
                waypoints: [
                    L.latLng(-34.6037, -58.3816), // CABA
                    L.latLng(-33.1473, -59.3041), // Gualeguay
                    L.latLng(-31.6157, -60.7048), // Sta Fe capital
                    L.latLng(-31.4201, -64.1888)  // Córdoba
                ],
                router: router,
                showAlternatives: false,
                fitSelectedRoutes: false,
                show: false,
                addWaypoints: false,
                draggableWaypoints: false,
                createMarker: function() { return null; },
                lineOptions: {
                    styles: [
                        {color: '#dc3545', opacity: 0.8, weight: 6}
                    ]
                }
            }).addTo(map);

            // ===================================================================
            // MENÚ DESPLEGABLE (arriba a la derecha)
            // ===================================================================

            var rutasVisibles = true;
            var poligonosVisibles = true;

            var menuDesplegable = L.control({position: 'topright'});

            menuDesplegable.onAdd = function(map) {
                var div = L.DomUtil.create('div', 'leaflet-bar leaflet-control menu-desplegable');

                div.innerHTML = `
                    <a href="#" class="menu-toggle" title="Menú de opciones">☰</a>
                    <div class="menu-items">
                        <button class="menu-item" id="btnRutas">🛣️ Mostrar/Ocultar Rutas</button>
                        <button class="menu-item" id="btnPoligonos">▲ Mostrar/Ocultar Polígonos</button>
                    </div>
                `;

                // Toggle del menú desplegable
                div.querySelector('.menu-toggle').onclick = function(e) {
                    L.DomEvent.stop(e);
                    e.preventDefault();
                    div.classList.toggle('abierto');
                };

                // Botón para mostrar/ocultar rutas
                div.querySelector('#btnRutas').onclick = function(e) {
                    L.DomEvent.stop(e);
                    if (rutasVisibles) {
                        map.removeControl(ruta1);
                        map.removeControl(ruta2);
                        map.removeControl(ruta3);
                        rutasVisibles = false;
                    } else {
                        ruta1.addTo(map);
                        ruta2.addTo(map);
                        ruta3.addTo(map);
                        rutasVisibles = true;
                    }
                };

                // Botón para mostrar/ocultar polígonos
                div.querySelector('#btnPoligonos').onclick = function(e) {
                    L.DomEvent.stop(e);
                    if (poligonosVisibles) {
                        // Ocultar todos los polígonos
                        poligonosEnMapa.forEach(function(poly) {
                            map.removeLayer(poly);
                        });
                        poligonosVisibles = false;
                    } else {
                        // Mostrar todos los polígonos
                        poligonosEnMapa.forEach(function(poly) {
                            poly.addTo(map);
                        });
                        poligonosVisibles = true;
                    }
                };

                return div;
            };

            menuDesplegable.addTo(map);

            // ===================================================================
            // CONFIGURACIÓN DE LEAFLET.DRAW (Dibujar Polígonos)
            // ===================================================================

            // Capa para guardar los dibujos
            var drawnItems = new L.FeatureGroup();
            map.addLayer(drawnItems);

            // Configuración del Toolbar de Dibujo
            var drawControl = new L.Control.Draw({
                position: 'topleft',
                draw: {
                    polygon: {
                        shapeOptions: { color: '#f06' }, // Color fucsia para nuevos polígonos
                        allowIntersection: false,
                        drawError: {
                            color: '#e1e100',
                            message: '<strong>Error:</strong> No podés cruzar las líneas!'
                        },
                    },
                    // Desactivamos las otras herramientas de dibujo
                    polyline: false,
                    rectangle: false,
                    circle: false,
                    marker: false,
                    circlemarker: false
                },
                edit: {
                    featureGroup: drawnItems // Para editar en el futuro
                }
            });
            map.addControl(drawControl);

            // Evento cuando se crea un nuevo dibujo
            map.on(L.Draw.Event.CREATED, function (event) {
                var layer = event.layer;

                // Pedimos el nombre al usuario
                var nombre = prompt("Ingresá un nombre para esta zona:");
                if (!nombre) return; // Si cancela, no hacemos nada

                // Obtenemos las coordenadas del polígono dibujado
                var latLngs = layer.getLatLngs()[0]; // Array de LatLng

                // Convertimos a formato simple [[lat, lng], [lat, lng], ...]
                var coordenadas = latLngs.map(function(p) {
                    return [p.lat, p.lng];
                });

                // Guardamos en la base de datos
                guardarPoligono(nombre, coordenadas);
            });

            // ===================================================================
            // CARGA INICIAL DE DATOS
            // ===================================================================

            cargarMarcadores();
            cargarPoligonos();

            // ===================================================================
            // EVENTO: DOBLE CLIC para crear nuevo marcador
            // ===================================================================

            map.on('dblclick', function(e) {
                abrirPopupParaNuevoMarcador(e.latlng);
            });
        });

        // ===================================================================
        // ===================================================================
        // FUNCIONES PARA MARCADORES (CRUD)
        // ===================================================================
        // ===================================================================

        /**
         * Carga todos los marcadores desde la API
         */
        async function cargarMarcadores() {
            try {
                const response = await fetch('/api/marcadores');
                if (!response.ok) throw new Error('Error al cargar marcadores');

                const marcadores = await response.json();

                marcadores.forEach(function(marcador) {
                    agregarMarcadorAlMapa(marcador);
                });
            } catch (error) {
                console.error("Error en cargarMarcadores:", error);
            }
        }

        /**
         * Agrega un marcador al mapa con su popup
         */
        function agregarMarcadorAlMapa(marcador) {
            console.log("Marcador recibido:", marcador);

            const latLng = [marcador.latitud, marcador.longitud];
            var pin = L.marker(latLng).addTo(map);

            // Guardamos los datos del marcador en el objeto del pin
            pin.markerData = {
                id: marcador.id,
                nombre: marcador.nombre,
                latitud: marcador.latitud,
                longitud: marcador.longitud
            };

            // Contenido del popup
            var popupContent = `
                <div id="popup-ver-${marcador.id}">
                    <b>${marcador.nombre}</b>
                    <br>
                    <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${marcador.id})">Editar</button>
                    <button class="btn-borrar" onclick="borrarMarcador(event, ${marcador.id})">Borrar</button>
                </div>
            `;

            pin.bindPopup(popupContent);

            // Guardamos referencia en el objeto global
            marcadoresEnMapa[marcador.id] = pin;
        }

        /**
         * Abre un popup para crear un nuevo marcador
         */
        function abrirPopupParaNuevoMarcador(latlng) {
            var lat = latlng.lat.toFixed(6);
            var lng = latlng.lng.toFixed(6);

            var popupContent = `
                <div>
                    <b>Nuevo Marcador</b><br>
                    <small>Lat: ${lat}, Lng: ${lng}</small>
                    <hr style="margin: 4px 0;">
                    Nombre: <input type='text' id='inputNombreMarcador' />
                    <br>
                    <button onclick='guardarMarcador(event, ${latlng.lat}, ${latlng.lng})'>Guardar</button>
                </div>`;

            L.popup()
                .setLatLng(latlng)
                .setContent(popupContent)
                .openOn(map);
        }

        /**
         * Guarda un nuevo marcador en la base de datos
         */
        async function guardarMarcador(event, lat, lng) {
            event.stopPropagation();

            const nombre = document.getElementById('inputNombreMarcador').value;
            if (!nombre) {
                alert('Por favor, ingresa un nombre.');
                return;
            }

            const nuevoMarcador = {
                nombre: nombre,
                latitud: lat,
                longitud: lng
            };

            try {
                const response = await fetch('/api/marcadores', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(nuevoMarcador)
                });

                if (!response.ok) throw new Error('Error al guardar el marcador');

                const marcadorGuardado = await response.json();
                agregarMarcadorAlMapa(marcadorGuardado);
                map.closePopup();
            } catch (error) {
                console.error("Error en guardarMarcador:", error);
                alert('No se pudo guardar el marcador.');
            }
        }

        /**
         * Borra un marcador de la base de datos y del mapa
         */
        async function borrarMarcador(event, id) {
            event.stopPropagation();

            if (!confirm("¿Seguro que querés borrar este marcador?")) return;

            try {
                const response = await fetch(`/api/marcadores/${id}`, {
                    method: 'DELETE'
                });

                if (!response.ok) throw new Error('Error al borrar el marcador');

                var pin = marcadoresEnMapa[id];
                map.removeLayer(pin);
                delete marcadoresEnMapa[id];
                map.closePopup();
            } catch (error) {
                console.error("Error en borrarMarcador:", error);
                alert('No se pudo borrar el marcador.');
            }
        }

        /**
         * Muestra el formulario de edición en el popup
         */
        function mostrarFormularioEdicion(event, id) {
            event.stopPropagation();

            var pin = marcadoresEnMapa[id];
            var data = pin.markerData;

            var formContent = `
                <div>
                    <b>Editando:</b>
                    <br>
                    Nombre: <input type='text' id='inputEditarNombre-${id}' value='${data.nombre}' />
                    <br>
                    <button class="btn-guardar" onclick="guardarEdicion(event, ${id})">Guardar</button>
                    <button onclick="cancelarEdicion(event, ${id})">Cancelar</button>
                </div>
            `;

            pin.setPopupContent(formContent);
        }

        /**
         * Cancela la edición y vuelve al popup normal
         */
        function cancelarEdicion(event, id) {
            event.stopPropagation();

            var pin = marcadoresEnMapa[id];
            var data = pin.markerData;

            var popupContent = `
                <div id="popup-ver-${data.id}">
                    <b>${data.nombre}</b>
                    <br>
                    <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${data.id})">Editar</button>
                    <button class="btn-borrar" onclick="borrarMarcador(event, ${data.id})">Borrar</button>
                </div>
            `;

            pin.setPopupContent(popupContent);
        }

        /**
         * Guarda los cambios de edición en la base de datos
         */
        async function guardarEdicion(event, id) {
            event.stopPropagation();

            var pin = marcadoresEnMapa[id];
            var dataOriginal = pin.markerData;

            const nuevoNombre = document.getElementById(`inputEditarNombre-${id}`).value;
            if (!nuevoNombre) {
                alert('El nombre no puede estar vacío.');
                return;
            }

            const marcadorActualizado = {
                id: id,
                nombre: nuevoNombre,
                latitud: dataOriginal.latitud,
                longitud: dataOriginal.longitud
            };

            try {
                const response = await fetch(`/api/marcadores/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(marcadorActualizado)
                });

                if (!response.ok) throw new Error('Error al actualizar en la API');

                // Actualizamos los datos locales
                pin.markerData.nombre = nuevoNombre;

                // Volvemos al popup normal
                var popupContent = `
                    <div id="popup-ver-${id}">
                        <b>${nuevoNombre}</b>
                        <br>
                        <button class="btn-editar" onclick="mostrarFormularioEdicion(event, ${id})">Editar</button>
                        <button class="btn-borrar" onclick="borrarMarcador(event, ${id})">Borrar</button>
                    </div>
                `;
                pin.setPopupContent(popupContent);

            } catch (error) {
                console.error("Error en guardarEdicion:", error);
                alert('No se pudieron guardar los cambios.');
            }
        }

        // ===================================================================
        // ===================================================================
        // FUNCIONES PARA POLÍGONOS (CRUD)
        // ===================================================================
        // ===================================================================

        /**
         * Carga todos los polígonos desde la API
         */
        async function cargarPoligonos() {
            try {
                const response = await fetch('/api/poligonos');
                if (!response.ok) throw new Error('Error al cargar polígonos');

                const poligonos = await response.json();

                poligonos.forEach(function(poligono) {
                    // Convertir coordenadas al formato Leaflet [lat, lng]
                    var coordenadasLeaflet = poligono.coordenadas.map(function(p) {
                        return [p[0], p[1]]; // Ya vienen como [lat, lng] desde el backend
                    });

                    // Detectar si es el triángulo para aplicar estilo especial
                    var esTriangulo = poligono.nombre === 'Triángulo Equilátero Invertido';

                    // Configuración de estilo
                    var color = esTriangulo ? '#003366' : '#f06';
                    var fillOpacity = esTriangulo ? 0.4 : 0.2;

                    // Crear el polígono en el mapa
                    var polyLayer = L.polygon(coordenadasLeaflet, {
                        color: color,
                        fillColor: color,
                        fillOpacity: fillOpacity,
                        weight: 3
                    })
                    .bindPopup(`<b>${poligono.nombre}</b>`)
                    .addTo(map);

                    // Guardamos la referencia para poder mostrar/ocultar
                    poligonosEnMapa.push(polyLayer);
                });

            } catch (error) {
                console.error("Error en cargarPoligonos:", error);
            }
        }

        /**
         * Guarda un nuevo polígono en la base de datos
         */
        async function guardarPoligono(nombre, coordenadas) {
            const nuevoPoligono = {
                nombre: nombre,
                coordenadas: coordenadas // [[lat, lng], [lat, lng], ...]
            };

            try {
                const response = await fetch('/api/poligonos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(nuevoPoligono)
                });

                if (!response.ok) throw new Error('Error al guardar el polígono');

                const poligonoGuardado = await response.json();

                // Recargamos la página para mostrar el nuevo polígono
                // (Una versión más optimizada sería agregar solo el nuevo sin recargar)
                window.location.reload();

            } catch (error) {
                console.error("Error en guardarPoligono:", error);
                alert('No se pudo guardar el polígono.');
            }
        }
    </script>
}